<Window x:Class="AudioMesh.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AudioMesh.ViewModels"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="AudioMesh"
        Icon="Assets/AudioMesh.ico"
        Height="800" Width="1120"
        MinHeight="560" MinWidth="900"
        Background="{StaticResource AppBackdropBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="72"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="14"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseOverlayCommand}"/>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#E6080B12"
                BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,0,0,1" Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="Assets/AudioMesh.ico" Width="26" Height="26"
                           Margin="0,0,11,0" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="AudioMesh" FontSize="19" FontWeight="Bold"/>
                        <TextBlock Text="one stream · every endpoint" FontSize="11"
                                   Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="8" Padding="3">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="System audio" GroupName="Source" Margin="0,0,3,0"
                                         Style="{StaticResource Segment}"
                                         IsChecked="{Binding IsSystemSource, Mode=TwoWay}"/>
                            <RadioButton Content="Test tone" GroupName="Source"
                                         Style="{StaticResource Segment}"
                                         IsChecked="{Binding IsToneSource, Mode=TwoWay}"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="8" Padding="3"
                            Margin="10,0,0,0"
                            ToolTip="Mono downmixes everything before fan-out. Stereo keeps left and right intact.">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="Stereo" GroupName="OutputMode" Margin="0,0,3,0"
                                         Style="{StaticResource Segment}"
                                         IsChecked="{Binding IsStereoOutput, Mode=TwoWay}"/>
                            <RadioButton Content="Mono" GroupName="OutputMode"
                                         Style="{StaticResource Segment}"
                                         IsChecked="{Binding MonoOutput, Mode=TwoWay}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource GhostButton}"
                            AutomationProperties.Name="Refresh"
                            Command="{Binding RefreshCommand}" Margin="0,0,10,0" Width="112">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       Margin="0,0,7,0" VerticalAlignment="Center"
                                       RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform>
                                    <RotateTransform Angle="0"/>
                                </TextBlock.RenderTransform>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRefreshing}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard x:Name="RefreshSpin">
                                                        <Storyboard>
                                                            <DoubleAnimation
                                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                From="0" To="360" Duration="0:0:0.75"
                                                                RepeatBehavior="Forever"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <StopStoryboard BeginStoryboardName="RefreshSpin"/>
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="Refresh" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Content="{Binding StartButtonText}" Style="{StaticResource PrimaryButton}"
                            Command="{Binding ToggleCommand}" Width="126"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE946;"
                            Command="{Binding OpenAboutCommand}" Margin="8,0,0,0"
                            AutomationProperties.Name="About AudioMesh"
                            ToolTip="About, GitHub and support"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="14,0,-10,0"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE921;"
                            AutomationProperties.Name="Minimize"
                            Click="Minimize_Click" ToolTip="Minimize"/>
                    <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE922;"
                            AutomationProperties.Name="Maximize"
                            Click="Maximize_Click" ToolTip="Maximize"/>
                    <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;"
                            AutomationProperties.Name="Close"
                            Click="Close_Click" ToolTip="Close"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Devices -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,18,24,8">
            <StackPanel>
                <Border Background="{StaticResource CardGlassBrush}"
                        BorderBrush="{StaticResource GlassStrokeBrush}"
                        BorderThickness="1" CornerRadius="16"
                        Padding="14,12" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.02*"/>
                            <ColumnDefinition Width="1.45*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="4,0,18,0">
                            <Grid>
                                <TextBlock Text="Perfect sync" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding PerfectSync}"
                                              HorizontalAlignment="Right" AutomationProperties.Name="Perfect sync"
                                              ToolTip="Capture from a silent output and route every speaker through one pipeline"/>
                            </Grid>
                            <TextBlock Text="One shared capture" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="0" Width="1" Background="{StaticResource StrokeBrush}"
                                HorizontalAlignment="Right" Margin="0,1,0,1"/>

                        <StackPanel Grid.Column="1" Margin="18,0,18,0">
                            <Grid>
                                <TextBlock Text="Auto align" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Button Content="{Binding CalibrateButtonText}" Style="{StaticResource MiniButton}"
                                        Command="{Binding CalibrateCommand}" IsEnabled="{Binding CanCalibrate}"
                                        HorizontalAlignment="Right" MinWidth="88"
                                        AutomationProperties.Name="Calibrate"
                                        ToolTip="Measure each enabled speaker with the selected microphone"/>
                            </Grid>
                            <ComboBox Style="{StaticResource FlatCombo}" Height="26" FontSize="11" Margin="0,5,0,0"
                                      AutomationProperties.Name="Calibration microphone"
                                      ItemsSource="{Binding Microphones}"
                                      SelectedItem="{Binding SelectedMicrophone, Mode=TwoWay}"
                                      IsEnabled="{Binding CanCalibrate}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <Border Grid.Column="1" Width="1" Background="{StaticResource StrokeBrush}"
                                HorizontalAlignment="Right" Margin="0,1,0,1"/>

                        <StackPanel Grid.Column="2" Margin="18,0,18,0">
                            <Grid>
                                <TextBlock Text="Buffer mode" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding LatencyEstimate}" FontSize="10"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Foreground="{StaticResource MutedBrush}"/>
                            </Grid>
                            <ComboBox Style="{StaticResource FlatCombo}" Height="26" FontSize="11" Margin="0,5,0,0"
                                      AutomationProperties.Name="Buffer mode"
                                      ItemsSource="{Binding LatencyOptions}"
                                      SelectedItem="{Binding SelectedLatencyOption, Mode=TwoWay}"
                                      ToolTip="{Binding LatencyHint}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Label}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="{Binding LatencyHint}" FontSize="10"
                                       Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Border Grid.Column="2" Width="1" Background="{StaticResource StrokeBrush}"
                                HorizontalAlignment="Right" Margin="0,1,0,1"/>

                        <StackPanel Grid.Column="3" Margin="18,0,4,0">
                            <Grid>
                                <TextBlock Text="Start with Windows" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding LaunchAtLogin}"
                                              HorizontalAlignment="Right" AutomationProperties.Name="Start with Windows"
                                              ToolTip="Launch AudioMesh at sign-in and keep it in the tray"/>
                            </Grid>
                            <Grid Margin="0,6,0,0">
                                <TextBlock Text="Start routing" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding AutoStart}"
                                              HorizontalAlignment="Right" AutomationProperties.Name="Start routing on launch"
                                              ToolTip="Start routing automatically when AudioMesh opens"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Margin="4,0,4,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="6" Height="6" Fill="{Binding CalibrationStatusBrush}"
                             VerticalAlignment="Top" Margin="0,4,7,0"/>
                    <TextBlock Grid.Column="1" Text="{Binding CalibrationStatus}" FontSize="10"
                               Foreground="{Binding CalibrationStatusBrush}" TextWrapping="Wrap"/>
                </Grid>

                <TextBlock Text="{Binding SummaryText}" Foreground="{StaticResource MutedBrush}"
                           FontSize="12" Margin="2,0,0,14"/>

                <Border Background="{StaticResource WarnSoftBrush}"
                        BorderBrush="{StaticResource WarnBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="12,10" Margin="0,0,0,14"
                        Visibility="{Binding ShowBluetoothWarning, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Foreground="{StaticResource WarnBrush}"
                                   VerticalAlignment="Top" Margin="0,1,10,0"/>
                        <TextBlock Text="{Binding BluetoothWarningText}" TextWrapping="Wrap"
                                   FontSize="11" Foreground="{StaticResource WarnBrush}"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="No active playback endpoints found. Connect a device and press Refresh."
                           Foreground="{StaticResource MutedBrush}" Margin="2,24,0,0"
                           Visibility="{Binding HasDevices, Converter={StaticResource InverseBoolToVisibility}}"/>

                <ItemsControl ItemsSource="{Binding Devices}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="40" Height="40" CornerRadius="12"
                                                    Background="{Binding BadgeSoftBrush}"
                                                    BorderBrush="{Binding BadgeBrush}" BorderThickness="1"
                                                    Margin="0,0,12,0" VerticalAlignment="Top">
                                                <TextBlock Text="{Binding TypeGlyph}"
                                                           FontFamily="Segoe MDL2 Assets" FontSize="17"
                                                           Foreground="{Binding BadgeBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <StackPanel VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                               MaxWidth="360"/>
                                                    <Border Background="{Binding BadgeBrush}" CornerRadius="5"
                                                            Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Kind}" FontSize="9.5" FontWeight="Bold"
                                                                   Foreground="#0C0E13"/>
                                                    </Border>
                                                    <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="5"
                                                            Padding="6,2" Margin="6,0,0,0" VerticalAlignment="Center"
                                                            Visibility="{Binding IsDefault, Converter={StaticResource BoolToVisibility}}">
                                                        <TextBlock Text="DEFAULT" FontSize="9.5" FontWeight="Bold"
                                                                   Foreground="{StaticResource AccentBrush}"/>
                                                    </Border>
                                                </StackPanel>

                                                <TextBlock Text="{Binding DetailText}" FontSize="11"
                                                           Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                    <Ellipse Width="6" Height="6" Fill="{Binding StatusBrush}"
                                                             VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{Binding StatusText}" FontSize="11"
                                                               Foreground="{StaticResource MutedBrush}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>

                                        <Grid Margin="0,16,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Canvas Grid.Column="0" Width="140" Height="8" VerticalAlignment="Center">
                                                <Border Width="140" Height="8" CornerRadius="4"
                                                        Background="#0C1119" BorderBrush="#26303F" BorderThickness="1"/>
                                                <Rectangle Width="{Binding LevelWidth}" Height="8"
                                                           RadiusX="4" RadiusY="4" HorizontalAlignment="Left">
                                                    <Rectangle.Fill>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                            <GradientStop Color="#35C58A" Offset="0"/>
                                                            <GradientStop Color="#7BD88B" Offset="0.55"/>
                                                            <GradientStop Color="#F2A33A" Offset="0.82"/>
                                                            <GradientStop Color="#FF5F57" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Rectangle.Fill>
                                                </Rectangle>
                                                <Rectangle Canvas.Left="{Binding PeakHoldWidth}" Width="2" Height="8"
                                                           RadiusX="1" RadiusY="1" Fill="#EAF1FF"/>
                                            </Canvas>

                                            <StackPanel Grid.Column="1" Margin="20,0,20,0">
                                                <Grid>
                                                    <StackPanel Orientation="Horizontal">
                                                        <ToggleButton Style="{StaticResource MuteToggle}"
                                                                      IsChecked="{Binding Muted}"
                                                                      IsEnabled="{Binding IsEnabled}"
                                                                      Margin="0,0,5,0"
                                                                      AutomationProperties.Name="Mute"/>
                                                        <TextBlock Text="Volume" FontSize="10"
                                                                   Foreground="{StaticResource MutedBrush}"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Volume, StringFormat={}{0:0}%}"
                                                               FontSize="10" HorizontalAlignment="Right"
                                                               VerticalAlignment="Center"
                                                               Foreground="{StaticResource MutedBrush}"/>
                                                </Grid>
                                                <Slider Minimum="0" Maximum="100" Value="{Binding Volume}"
                                                        Style="{StaticResource FlatSlider}" Margin="0,2,0,0"
                                                        IsEnabled="{Binding IsEnabled}"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Width="190">
                                                <Grid>
                                                    <TextBlock Text="Sync delay" FontSize="10"
                                                               Foreground="{StaticResource MutedBrush}"/>
                                                    <TextBlock Text="{Binding DelayMs, StringFormat={}{0:0} ms}"
                                                               FontSize="10" HorizontalAlignment="Right"
                                                               Foreground="{StaticResource MutedBrush}"/>
                                                </Grid>
                                                <Slider Minimum="0" Maximum="500" Value="{Binding DelayMs}"
                                                        Style="{StaticResource FlatSlider}" Margin="0,2,0,0"
                                                        IsEnabled="{Binding IsEnabled}"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="3" Width="160" Margin="20,0,0,0">
                                                <TextBlock Text="Channel" FontSize="10"
                                                           Foreground="{StaticResource MutedBrush}"/>
                                                <ComboBox Style="{StaticResource FlatCombo}" Margin="0,3,0,0"
                                                          ItemsSource="{Binding Source={x:Static vm:ChannelOption.All}}"
                                                          SelectedValuePath="Mode"
                                                          SelectedValue="{Binding Channel, Mode=TwoWay}"
                                                          IsEnabled="{Binding IsEnabled}"
                                                          ToolTip="{Binding ChannelHint}">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Label}"/>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>

                                                <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                                    <Button Style="{StaticResource EqChip}"
                                                            Command="{Binding OpenEqCommand}"
                                                            AutomationProperties.Name="Open tuning"
                                                            ToolTip="Per-speaker EQ and surround tuning">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="EQ" FontWeight="Bold" FontSize="9"
                                                                       Foreground="{StaticResource AccentBrush}"/>
                                                            <TextBlock Text="{Binding EqSummary}" FontSize="10"
                                                                       Margin="5,0,0,0" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>

                                                    <Button Style="{StaticResource EqChip}"
                                                            Command="{Binding ToggleSpatialCommand}"
                                                            IsEnabled="{Binding SupportsSpatial}"
                                                            Margin="6,0,0,0"
                                                            AutomationProperties.Name="Virtual surround"
                                                            ToolTip="{Binding SpatialTooltip}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse Width="5" Height="5" Margin="0,0,5,0"
                                                                     VerticalAlignment="Center"
                                                                     Fill="{Binding SpatialBrush}"/>
                                                            <TextBlock Text="Surround" FontSize="9.5"
                                                                       VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding SpatialSummary}" FontSize="9.5"
                                                                       Margin="4,0,0,0" VerticalAlignment="Center"
                                                                       Foreground="{StaticResource MutedBrush}"/>
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="22,0,0,0">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Style="{StaticResource IconButton}"
                                                    Content="&#xE70E;"
                                                    Command="{Binding MoveUpCommand}"
                                                    IsEnabled="{Binding CanMoveUp}"
                                                    AutomationProperties.Name="Move up"
                                                    ToolTip="Move up"/>
                                            <Button Style="{StaticResource IconButton}"
                                                    Content="&#xE70D;"
                                                    Margin="5,0,0,0"
                                                    Command="{Binding MoveDownCommand}"
                                                    IsEnabled="{Binding CanMoveDown}"
                                                    AutomationProperties.Name="Move down"
                                                    ToolTip="Move down"/>
                                        </StackPanel>
                                        <ToggleButton Style="{StaticResource Switch}"
                                                      Margin="0,10,0,0"
                                                      HorizontalAlignment="Center"
                                                      IsChecked="{Binding IsEnabled}"
                                                      IsEnabled="{Binding CanRoute}"
                                                      AutomationProperties.Name="Route audio to this endpoint"
                                                      ToolTip="Route audio to this endpoint"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,1,0,0" Padding="24,12">
            <StackPanel>
                <TextBlock Text="{Binding StatusText}" FontSize="12"/>
                <TextBlock Text="{Binding HintText}" FontSize="11" TextWrapping="Wrap"
                           Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Equalizer overlay -->
        <Border Grid.Row="0" Grid.RowSpan="3" Panel.ZIndex="20"
                Background="#CC04060A"
                Visibility="{Binding IsEqOpen, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{StaticResource GlassPanel}"
                    Width="900" MaxHeight="780"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    DataContext="{Binding EqDevice}">
                <Grid Margin="28,24,28,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <StackPanel>
                            <TextBlock Text="SPEAKER TUNING" FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource AccentBrush}"/>
                            <TextBlock Text="{Binding Name}" FontSize="21" FontWeight="Bold"
                                       Margin="0,4,0,0" TextTrimming="CharacterEllipsis" MaxWidth="720"
                                       HorizontalAlignment="Left"/>
                            <TextBlock Text="{Binding DetailText}" FontSize="11"
                                       Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Button Style="{StaticResource CaptionButton}" Content="&#xE8BB;"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Command="{Binding DataContext.CloseEqCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                AutomationProperties.Name="Close equalizer" ToolTip="Close"/>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Preset" FontSize="10"
                                   Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox Grid.Column="1" Width="190" Style="{StaticResource FlatCombo}"
                                  ItemsSource="{Binding EqPresets}" SelectedItem="{Binding EqPreset}"
                                  AutomationProperties.Name="EQ preset"/>
                        <TextBlock Grid.Column="3" Text="{Binding EqPreampText}" FontSize="10"
                                   Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                    </Grid>

                    <Border Grid.Row="2" Background="#0A0E15"
                            BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1"
                            CornerRadius="14" Height="164" Margin="0,14,0,0" ClipToBounds="True">
                        <Canvas Width="784" Height="142" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Line X1="0" Y1="60" X2="784" Y2="60" Stroke="#263142" StrokeThickness="1"/>
                            <Line X1="392" Y1="0" X2="392" Y2="120" Stroke="#1A2230" StrokeThickness="1"/>
                            <Line X1="0" Y1="0" X2="784" Y2="0" Stroke="#121923" StrokeThickness="1"/>
                            <Line X1="0" Y1="120" X2="784" Y2="120" Stroke="#121923" StrokeThickness="1"/>
                            <Polyline Points="{Binding EqCurve}" Stroke="{StaticResource AccentBrush}"
                                      StrokeThickness="2.4" StrokeLineJoin="Round">
                                <Polyline.Effect>
                                    <DropShadowEffect Color="#4C8DFF" BlurRadius="14" ShadowDepth="0" Opacity="0.75"/>
                                </Polyline.Effect>
                            </Polyline>
                            <TextBlock Canvas.Left="2" Canvas.Top="124" Text="20 Hz" FontSize="9"
                                       Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock Canvas.Left="374" Canvas.Top="124" Text="1 kHz" FontSize="9"
                                       Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock Canvas.Left="744" Canvas.Top="124" Text="20 kHz" FontSize="9"
                                       Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock Canvas.Left="2" Canvas.Top="2" Text="+12" FontSize="9"
                                       Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock Canvas.Left="2" Canvas.Top="108" Text="-12" FontSize="9"
                                       Foreground="{StaticResource MutedBrush}"/>
                        </Canvas>
                    </Border>

                    <ItemsControl Grid.Row="3" ItemsSource="{Binding EqBands}" Margin="0,18,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding Gain, StringFormat={}{0:+0.0;-0.0;0.0}}"
                                               FontSize="10" HorizontalAlignment="Center"
                                               Foreground="{StaticResource MutedBrush}"/>
                                    <Slider Style="{StaticResource EqSlider}"
                                            Minimum="-12" Maximum="12" Value="{Binding Gain}"
                                            Margin="0,6,0,4"
                                            AutomationProperties.Name="{Binding Label}"/>
                                    <TextBlock Text="{Binding Label}" FontSize="10"
                                               HorizontalAlignment="Center"
                                               Foreground="{StaticResource MutedBrush}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid Grid.Row="4" Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1.25*"/>
                            <ColumnDefinition Width="1.3*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,20,0">
                            <Grid>
                                <TextBlock Text="Bass" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock Text="{Binding Bass, StringFormat={}{0:+0.0;-0.0;0.0} dB}"
                                           FontSize="10" HorizontalAlignment="Right"
                                           Foreground="{StaticResource MutedBrush}"/>
                            </Grid>
                            <Slider Minimum="-12" Maximum="12" Value="{Binding Bass}"
                                    Style="{StaticResource FlatSlider}" Margin="0,4,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,0,20,0">
                            <Grid>
                                <TextBlock Text="Treble" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock Text="{Binding Treble, StringFormat={}{0:+0.0;-0.0;0.0} dB}"
                                           FontSize="10" HorizontalAlignment="Right"
                                           Foreground="{StaticResource MutedBrush}"/>
                            </Grid>
                            <Slider Minimum="-12" Maximum="12" Value="{Binding Treble}"
                                    Style="{StaticResource FlatSlider}" Margin="0,4,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Margin="0,0,20,0">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="5" Height="5" Margin="0,0,6,0"
                                             VerticalAlignment="Center" Fill="{Binding SpatialBrush}"/>
                                    <TextBlock Text="Surround" FontSize="11"
                                               Foreground="{StaticResource MutedBrush}"/>
                                </StackPanel>
                                <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding SpatialEnabled}"
                                              HorizontalAlignment="Right" IsEnabled="{Binding SupportsSpatial}"
                                              AutomationProperties.Name="Virtual surround"/>
                            </Grid>
                            <Grid Margin="0,5,0,0">
                                <TextBlock Text="Width" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock Text="{Binding SpatialAmount, StringFormat={}{0:0}%}"
                                           FontSize="10" HorizontalAlignment="Right"
                                           Foreground="{StaticResource MutedBrush}"/>
                            </Grid>
                            <Slider Minimum="0" Maximum="100" Value="{Binding SpatialAmount}"
                                    Style="{StaticResource FlatSlider}"
                                    IsEnabled="{Binding SupportsSpatial}"
                                    Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="3">
                            <Grid>
                                <TextBlock Text="Loudness" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                                <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding Loudness}"
                                              HorizontalAlignment="Right"
                                              AutomationProperties.Name="Loudness"/>
                            </Grid>
                            <Grid Margin="0,5,0,0">
                                <TextBlock Text="Amount" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock Text="{Binding LoudnessAmount, StringFormat={}{0:0}%}"
                                           FontSize="10" HorizontalAlignment="Right"
                                           Foreground="{StaticResource MutedBrush}"/>
                            </Grid>
                            <Slider Minimum="0" Maximum="100" Value="{Binding LoudnessAmount}"
                                    Style="{StaticResource FlatSlider}" IsEnabled="{Binding Loudness}"
                                    Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="5" Margin="0,20,0,0">
                        <TextBlock Text="{Binding EqSummary}" FontSize="11"
                                   Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Reset" Style="{StaticResource GhostButton}"
                                    Command="{Binding ResetEqCommand}" Height="34" Margin="0,0,8,0"/>
                            <Button Content="Done" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding DataContext.CloseEqCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Height="34" Width="96"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Border>

        <!-- About overlay -->
        <Border Grid.Row="0" Grid.RowSpan="3" Panel.ZIndex="22"
                Background="#CC04060A"
                Visibility="{Binding IsAboutOpen, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{StaticResource GlassPanel}" Width="620" MaxHeight="620"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid Margin="30,26,30,22">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <TextBlock Text="ABOUT AUDIOMESH" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding VersionText}" FontSize="10"
                                       Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"
                                       Margin="0,0,10,0"/>
                            <Button Style="{StaticResource CaptionButton}" Content="&#xE8BB;"
                                    Command="{Binding CloseAboutCommand}"
                                    AutomationProperties.Name="Close about" ToolTip="Close"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,20,0,0">
                        <Border Width="88" Height="88" CornerRadius="22" ClipToBounds="True"
                                Background="#10151E" BorderBrush="{StaticResource StrokeBrush}"
                                BorderThickness="1">
                            <Image Source="Assets/icon.png" Stretch="UniformToFill"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Margin="18,0,0,0">
                            <TextBlock Text="AudioMesh" FontSize="28" FontWeight="Bold"/>
                            <TextBlock Text="One stream. Every speaker." FontSize="13"
                                       Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Grid.Row="2" Margin="0,18,0,0" FontSize="12" LineHeight="19"
                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                               Text="Route one audio stream to every Windows output at once — Bluetooth, USB, HDMI and analog. Clock-drift correction, microphone auto-align, per-speaker EQ, virtual surround and a notification-area home."/>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,22,0,0">
                        <Button Style="{StaticResource CoffeeButton}"
                                Command="{Binding OpenSupportCommand}"
                                AutomationProperties.Name="Buy me a coffee"
                                ToolTip="Open buymeacoffee.com/issac_john">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="18" Height="18" Margin="0,0,9,0">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M4.5,7.5 H16.5 V14.5 C16.5,17.6 14.4,20 10.5,20 C6.6,20 4.5,17.6 4.5,14.5 Z"
                                              Stroke="#1A1400" StrokeThickness="1.7"
                                              StrokeLineJoin="Round" Fill="Transparent"/>
                                        <Path Data="M16.5,9.5 H18.2 C20,9.5 21,10.8 21,12.2 C21,13.6 20,15 18.2,15 H16.5"
                                              Stroke="#1A1400" StrokeThickness="1.7"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                                        <Path Data="M8,4.2 C9,2.8 7.6,2.2 8.6,0.9 M11.4,4.2 C12.4,2.8 11,2.2 12,0.9"
                                              Stroke="#1A1400" StrokeThickness="1.5"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                                        <Path Data="M10.5,10.6 C9.8,9.7 8.5,10.4 9.2,11.6 L10.5,13 L11.8,11.6 C12.5,10.4 11.2,9.7 10.5,10.6 Z"
                                              Fill="#1A1400" StrokeThickness="0"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="Buy me a coffee" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Content="GitHub" Style="{StaticResource GhostButton}" Height="40"
                                Margin="10,0,0,0" Command="{Binding OpenGitHubCommand}"
                                AutomationProperties.Name="Open GitHub repository"
                                ToolTip="github.com/issacjohn/AudioMesh"/>
                    </StackPanel>

                    <Grid Grid.Row="4" Margin="0,22,0,0">
                        <TextBlock Text="Built with WPF, NAudio and a custom sinc resampler."
                                   FontSize="10" Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center"/>
                        <Button Content="Close" Style="{StaticResource GhostButton}" Height="34" Width="88"
                                HorizontalAlignment="Right" Command="{Binding CloseAboutCommand}"/>
                    </Grid>
                </Grid>
            </Border>
        </Border>

        <Rectangle Grid.Row="0" Grid.RowSpan="3" Panel.ZIndex="25"
                   IsHitTestVisible="False" Opacity="0.03">
            <Rectangle.Fill>
                <ImageBrush ImageSource="Assets/noise.png" TileMode="Tile"
                            Viewport="0,0,128,128" ViewportUnits="Absolute" Stretch="None"/>
            </Rectangle.Fill>
        </Rectangle>

        <Border Grid.Row="0" Grid.RowSpan="3" Panel.ZIndex="30"
                BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="16"
                IsHitTestVisible="False"/>
    </Grid>
</Window>
